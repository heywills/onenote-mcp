<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Installed with OneNote desktop. Its managed wrapper class works from 64-bit .NET. -->
    <OneNoteInteropPath>$(WINDIR)\assembly\GAC_MSIL\Microsoft.Office.Interop.OneNote\15.0.0.0__71e9bce111e9429c\Microsoft.Office.Interop.OneNote.dll</OneNoteInteropPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.11.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Office.Interop.OneNote">
      <HintPath>$(OneNoteInteropPath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <Target Name="CheckOneNoteInterop" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(OneNoteInteropPath)')">
    <Error Text="OneNote interop assembly not found at $(OneNoteInteropPath). Install OneNote desktop (Microsoft 365)." />
  </Target>

</Project>
